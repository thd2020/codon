// Codon on Cloudflare Workers: the built game (dist/) served as static assets.
// Deployed by .github/workflows/deploy.yml; setup in README.md, "Deploying".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codon",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
